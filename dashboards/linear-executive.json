{
  "title": "Linear Executive Summary",
  "uid": "linear-executive",
  "schemaVersion": 38,
  "tags": [
    "linear",
    "engineering"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "team",
        "type": "query",
        "label": "Team",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(linear_team_issues_total, team)",
        "query": {
          "query": "label_values(linear_team_issues_total, team)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "KPIs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Issues Shipped (30d)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(linear_issues_completed_total{team=~\"$team\"}[30d]))",
          "refId": "A",
          "legendFormat": "Issues Shipped"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Avg Cycle Time (30d)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(linear_issue_cycle_time_seconds_bucket{team=~\"$team\"}[30d]))",
          "refId": "A",
          "legendFormat": "P50 Cycle Time"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 259200
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "On-Time Delivery %",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(linear_project_progress_percent >= 100 and linear_project_target_date_timestamp >= time()) / count(linear_project_progress_percent) * 100",
          "refId": "A",
          "legendFormat": "On-Time %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Team Throughput Trend",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(linear_team_throughput_issues_per_week{team=~\"$team\"})",
          "refId": "A",
          "legendFormat": "Issues/Week"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Delivery Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "id": 7,
      "title": "Project Health Distribution",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(linear_project_health == 0)",
          "refId": "A",
          "legendFormat": "On Track"
        },
        {
          "expr": "count(linear_project_health == 1)",
          "refId": "B",
          "legendFormat": "At Risk"
        },
        {
          "expr": "count(linear_project_health == 2)",
          "refId": "C",
          "legendFormat": "Off Track"
        }
      ],
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "On Track",
                  "color": "green"
                },
                "1": {
                  "text": "At Risk",
                  "color": "yellow"
                },
                "2": {
                  "text": "Off Track",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "0"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#1F9B4C",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "On Track"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F59E0B",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "At Risk"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#EF4444",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Off Track"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "SLA Breach Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(linear_sla_breached_total)",
          "refId": "A",
          "legendFormat": "SLA Breaches"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "showPoints": "auto",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLA Breaches"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#EF4444",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Capacity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 10,
      "title": "Issues per Engineer",
      "type": "barchart",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (assignee) (linear_member_assigned_issues_total{state!~\"Done|Cancelled\"})",
          "refId": "A",
          "legendFormat": "{{assignee}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "barRadius": 0.05,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "fullHighlight": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "WIP per Team",
      "type": "barchart",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "linear_team_wip_issues_total{team=~\"$team\"}",
          "refId": "A",
          "legendFormat": "{{team}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "auto",
        "barRadius": 0.05,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 100,
        "fullHighlight": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Quality Proxy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "id": 13,
      "title": "Bugs vs Features",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(linear_label_issues_total{label=\"bug\", state!~\"Done|Cancelled\"})",
          "refId": "A",
          "legendFormat": "Bugs (open)"
        },
        {
          "expr": "sum(linear_label_issues_total{label!=\"bug\", state!~\"Done|Cancelled\"})",
          "refId": "B",
          "legendFormat": "Features / Other (open)"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "auto",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bugs (open)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#EF4444",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Features / Other (open)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3B82F6",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
