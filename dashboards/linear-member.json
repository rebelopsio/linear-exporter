      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Cycle Time Distribution",
      "type": "heatmap",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (le) (linear_member_cycle_time_seconds_bucket{assignee=~\"$assignee\"})",
          "refId": "A",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "cellRadius": 2,
        "color": {
          "scheme": "Oranges",
          "fill": "dark-orange",
          "scale": "exponential",
          "steps": 64
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "decimals": 0
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 2
            }
          }
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "WIP Trend",
