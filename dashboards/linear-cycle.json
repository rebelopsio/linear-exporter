{
  "dashboard": {
    "title": "Linear Cycle / Sprint Board",
    "tags": ["linear", "engineering"],
    "uid": "linear-cycle",
    "schemaVersion": 38,
    "version": 1,
    "timezone": "browser",
    "style": "dark",
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5m", "10m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "team",
          "label": "Team",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": {
            "query": "label_values(linear_cycle_issues_total, team)",
            "refId": "StandardVariableQuery"
          },
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {},
          "hide": 0,
          "sort": 1
        },
        {
          "name": "cycle",
          "label": "Cycle",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": {
            "query": "label_values(linear_cycle_issues_total, cycle)",
            "refId": "StandardVariableQuery"
          },
          "refresh": 2,
          "includeAll": false,
          "multi": false,
          "current": {},
          "hide": 0,
          "sort": 1
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Burndown",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Burndown",
        "type": "timeseries",
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_scope_points{cycle=~\"$cycle\", team=~\"$team\"} - linear_cycle_completed_points{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "Remaining Points"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "spanNulls": false
            },
            "unit": "short",
            "min": 0
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Remaining Points" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
              ]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "single", "sort": "none" },
          "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
        },
        "transformations": [],
        "description": "Points remaining in the cycle. The ideal burndown line can be overlaid as an annotation from the cycle start/end dates."
      },
      {
        "id": 3,
        "title": "Burnup",
        "type": "timeseries",
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_completed_points{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "Completed"
          },
          {
            "expr": "linear_cycle_scope_points{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "B",
            "legendFormat": "Scope"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "spanNulls": false
            },
            "unit": "short",
            "min": 0
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Completed" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
                { "id": "custom.fillOpacity", "value": 20 }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Scope" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
                { "id": "custom.fillOpacity", "value": 0 }
              ]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "none" },
          "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
        }
      },
      {
        "id": 4,
        "type": "row",
        "title": "Scope",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }
      },
      {
        "id": 5,
        "title": "Total Scope Points",
        "type": "stat",
        "gridPos": { "h": 5, "w": 8, "x": 0, "y": 11 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_scope_points{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "Scope Points"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "blue", "value": null }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Scope Added After Start",
        "type": "stat",
        "gridPos": { "h": 5, "w": 8, "x": 8, "y": 11 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_added_issues_total{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "Added Issues"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 3 },
                { "color": "red", "value": 8 }
              ]
            },
            "unit": "short"
          }
        },
        "description": "Issues added after the cycle started. Yellow/red thresholds indicate scope creep risk (>10% of typical scope)."
      },
      {
        "id": 7,
        "title": "Completed %",
        "type": "gauge",
        "gridPos": { "h": 5, "w": 8, "x": 16, "y": 11 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_progress_percent{cycle=~\"$cycle\", team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "Progress"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "minVizHeight": 75,
          "minVizWidth": 75
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 40 },
                { "color": "green", "value": 70 }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 8,
        "type": "row",
        "title": "Issue Breakdown",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
      },
      {
        "id": 9,
        "title": "By State",
        "type": "piechart",
        "gridPos": { "h": 9, "w": 8, "x": 0, "y": 17 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "sum by (state) (linear_cycle_issues_total{cycle=~\"$cycle\", team=~\"$team\"})",
            "refId": "A",
            "legendFormat": "{{state}}"
          }
        ],
        "options": {
          "pieType": "pie",
          "displayLabels": ["name", "percent"],
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "calcs": []
          },
          "tooltip": { "mode": "single" }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            }
          }
        }
      },
      {
        "id": 10,
        "title": "By Assignee",
        "type": "barchart",
        "gridPos": { "h": 9, "w": 8, "x": 8, "y": 17 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "sum by (assignee) (linear_issues_total{cycle=~\"$cycle\", team=~\"$team\"})",
            "refId": "A",
            "legendFormat": "{{assignee}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "xTickLabelRotation": 0,
          "xTickLabelSpacing": 100,
          "showValue": "auto",
          "barWidth": 0.7,
          "groupWidth": 0.7,
          "stacking": "none",
          "fillOpacity": 80,
          "gradientMode": "none",
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": []
          },
          "tooltip": { "mode": "single", "sort": "none" }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "fillOpacity": 80,
              "gradientMode": "none",
              "lineWidth": 1
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 11,
        "title": "By Label",
        "type": "barchart",
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 17 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "sum by (label) (linear_issues_total{cycle=~\"$cycle\", team=~\"$team\"})",
            "refId": "A",
            "legendFormat": "{{label}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "xTickLabelRotation": 0,
          "xTickLabelSpacing": 100,
          "showValue": "auto",
          "barWidth": 0.7,
          "groupWidth": 0.7,
          "stacking": "none",
          "fillOpacity": 80,
          "gradientMode": "none",
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": []
          },
          "tooltip": { "mode": "single", "sort": "none" }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "fillOpacity": 80,
              "gradientMode": "none",
              "lineWidth": 1
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 12,
        "type": "row",
        "title": "Velocity",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
      },
      {
        "id": 13,
        "title": "Velocity History (Last 8 Cycles)",
        "type": "barchart",
        "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "linear_cycle_completed_points{team=~\"$team\"}",
            "refId": "A",
            "legendFormat": "{{cycle}}"
          }
        ],
        "options": {
          "orientation": "vertical",
          "xTickLabelRotation": -30,
          "xTickLabelSpacing": 100,
          "showValue": "auto",
          "barWidth": 0.6,
          "groupWidth": 0.7,
          "stacking": "none",
          "fillOpacity": 80,
          "gradientMode": "none",
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": ["mean", "max"]
          },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "fillOpacity": 80,
              "gradientMode": "none",
              "lineWidth": 1
            },
            "unit": "short",
            "min": 0
          }
        },
        "description": "Completed story points per cycle for the selected team. Use the time range to scope to the last 8 cycles."
      }
    ]
  }
}
